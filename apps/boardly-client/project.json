{
  "name": "boardly-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/boardly-client/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "defaultConfiguration": "production",
      "outputs": ["{options.outputPath}"],
      "options": {
        "configFile": "apps/boardly-client/vite.config.mts",
        "outputPath": "dist/apps/boardly-client",
        "tsConfig": "apps/boardly-client/tsconfig.app.json"
      },
      "configurations": {
        "development": {
          "mode": "development",
          "sourcemap": true
        },
        "production": {
          "sourcemap": false,
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "options": {
        "buildTarget": "boardly-client:build",
        "port": 4200
      },
      "configurations": {
        "production": {
          "buildTarget": "boardly-client:build:production"
        },
        "development": {
          "buildTarget": "boardly-client:build:development",
          "hmr": true
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "boardly-client:build"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "boardly-client:build",
        "port": 4200,
        "staticFilePath": "dist/apps/boardly-client/browser",
        "spa": true
      }
    }
  }
}
